[Unit]
Description=BetterLinuxCNC process orchestration
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart="@CMAKE_INSTALL_FULL_BINDIR@/betterlinuxcnc-launch" --config "@BETTERCNC_PROJECT_DIR@/launcher.json"
Environment="BETTERCNC_LOG_ROOT=/var/log/betterlinuxcnc/launcher" "XDG_CACHE_HOME=/var/cache/betterlinuxcnc/user" "BETTERCNC_SHARE_LOGS=1"
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78 SIGINT SIGTERM SIGKILL
KillMode=process
SendSIGKILL=no
TimeoutStopSec=330
UMask=0077
