// The operator can start only the two fixed update services, with no payload arguments.
polkit.addRule(function(action, subject) {
    if (subject.user !== "linuxcnc") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units"
        && (action.lookup("unit") === "betterlinuxcnc-system-update.service"
            || action.lookup("unit") === "betterlinuxcnc-mesa-flash.service")
        && action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
    // Never grant this account generic pkexec or other systemd management rights.
    if (action.id.indexOf("org.freedesktop.systemd1.") === 0
        || action.id === "org.freedesktop.policykit.exec") {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});
